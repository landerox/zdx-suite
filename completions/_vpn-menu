#compdef vpn-menu vpn-access-unlock vpn-access-lock vpn-access-status vpn-on vpn-off vpn-off-all vpn-reconnect-last vpn-default-connect vpn-default-set vpn-default-clear vpn-summary vpn-details vpn-ip-info vpn-mtu-probe vpn-report vpn-profile-create vpn-profile-import vpn-profile-rename vpn-config-edit vpn-config-dir vpn-config-restore vpn-profile-remove

local context state state_descr line
typeset -A opt_args

local -a subcmds
subcmds=(
  'vpn-access-unlock:Authenticate with sudo so profiles and tunnel state are readable'
  'vpn-access-lock:Invalidate this session sudo timestamp, which other sudo commands may share'
  'vpn-access-status:Explain whether profiles and live tunnel state are readable'
  'vpn-on:Bring a profile up with wg-quick'
  'vpn-off:Disconnect one active tunnel'
  'vpn-off-all:Bring down every active WireGuard interface'
  'vpn-reconnect-last:Reconnect the profile recorded as last used'
  'vpn-default-connect:Bring up the configured default profile'
  'vpn-default-set:Record one profile as the default target'
  'vpn-default-clear:Remove the saved default profile pointer'
  'vpn-summary:List safe profiles, active tunnels, backups, and cached pointers'
  'vpn-details:Show detailed WireGuard state for each active tunnel'
  'vpn-ip-info:Show tunnel addresses, endpoint, public exit, and DNS'
  'vpn-mtu-probe:Measure the path MTU with bounded pings and suggest MTU settings'
  'vpn-report:Atomically publish an owner-only Markdown diagnostic report'
  'vpn-profile-create:Atomically install a private profile skeleton'
  'vpn-profile-import:Validate and install a private hook-free .conf file'
  'vpn-profile-rename:Plan and rename a profile, backup, and saved pointers'
  'vpn-config-edit:Edit a profile as your user; the editor never runs as root'
  'vpn-config-dir:List a bounded inventory of safe profiles and backups'
  'vpn-config-restore:Atomically restore a profile and keep a private undo copy'
  'vpn-profile-remove:Plan and remove a profile after confirmation'
)

# Completion can run before either the suite or Core loads. Query only a
# frozen native Homebrew executable, with closed stdin and bounded output.
_vpn_menu_cold_brew_prefix() {
  emulate -L zsh
  setopt PIPE_FAIL
  REPLY=""
  local brew_program="" head_program="" timeout_program="" candidate=""
  local captured="" prefix=""
  brew_program=$(builtin whence -p -- brew 2>/dev/null) || return 1
  head_program=$(builtin whence -p -- head 2>/dev/null) || return 1
  for candidate in "$brew_program" "$head_program"; do
    [[ "$candidate" == /* && "$candidate" != *[[:cntrl:]]* \
      && -f "$candidate" && -x "$candidate" ]] || return 1
  done
  if (( ! ${+functions[_zdx_run_with_timeout]} )); then
    for candidate in timeout gtimeout; do
      timeout_program=$(builtin whence -p -- "$candidate" 2>/dev/null) \
        || timeout_program=""
      [[ "$timeout_program" == /* && "$timeout_program" != *[[:cntrl:]]* \
        && -f "$timeout_program" && -x "$timeout_program" ]] && break
      timeout_program=""
    done
    [[ -n "$timeout_program" ]] || return 1
  fi
  captured=$(
    local -i pipeline_status=0
    {
      if (( ${+functions[_zdx_run_with_timeout]} )); then
        _zdx_run_with_timeout 3 "$brew_program" --prefix
      else
        command "$timeout_program" -k 2s 3s "$brew_program" --prefix
      fi
    } </dev/null 2>/dev/null \
      | command "$head_program" -c 1025 2>/dev/null || pipeline_status=$?
    builtin print -rn -- . || { (( pipeline_status != 0 )) || pipeline_status=1; }
    return "$pipeline_status"
  ) || return 1
  unsetopt MULTIBYTE
  [[ "$captured" == *. ]] || return 1
  captured="${captured%.}"
  (( ${#captured} <= 1024 )) || return 1
  prefix="${captured%%$'\n'*}"
  [[ "$prefix" == /* && "$prefix" != *[[:cntrl:]]* && -d "$prefix" ]] || return 1
  REPLY="$prefix"
}

# Pure fallback inventory, separate from discovery so isolated completion
# fixtures can supply private directories without a public configuration knob.
_vpn_menu_cold_fallback_dirs() {
  (( $# == 0 )) || return 2
  reply=("${HOMEBREW_PREFIX:-/opt/homebrew}/etc/wireguard" /usr/local/etc/wireguard)
}

# REPLY: the cold directory selection. The optional system directory is a
# private isolation seam; ordinary completion uses the platform default.
_vpn_menu_cold_profile_dir() {
  emulate -L zsh
  REPLY=""
  (( $# <= 1 )) || return 2
  local system_dir="${1-/private/etc/wireguard}" selected_dir=""
  [[ "$system_dir" == /* && "$system_dir" != *[[:cntrl:]]* ]] || return 2
  selected_dir="${VPN_CONFIG_DIR:-/etc/wireguard}"
  if [[ -z "${VPN_CONFIG_DIR:-}" && "$OSTYPE" == darwin* ]]; then
    selected_dir="$system_dir"
    if [[ ! -e "$selected_dir" && ! -L "$selected_dir" ]]; then
      local brew_dir="" brew_prefix=""
      local -a reply=() directories=() brew_profiles=()
      _vpn_menu_cold_brew_prefix && brew_prefix="$REPLY"
      [[ -n "$brew_prefix" ]] && directories+=("$brew_prefix/etc/wireguard")
      _vpn_menu_cold_fallback_dirs || return 1
      directories+=("${reply[@]}")
      for brew_dir in "${directories[@]}"; do
        [[ "$brew_dir" == /* && "$brew_dir" != *[[:cntrl:]]* ]] || continue
        brew_profiles=("$brew_dir"/*.conf(N))
        if (( ${#brew_profiles[@]} > 0 )); then
          selected_dir="$brew_dir"
          break
        fi
      done
    fi
  fi
  [[ "$selected_dir" == /* && "$selected_dir" != *[[:cntrl:]]* ]] || return 1
  REPLY="$selected_dir"
}

# Profile names come from the configured directory when it is readable without
# privileges. Completion never invokes sudo. A loaded suite resolves the
# directory itself; otherwise its rules are mirrored here: the macOS default
# directory, and a symbolic link accepted only as a root-owned system alias,
# such as /etc -> private/etc, inside a root-owned directory nobody else can
# write.
_vpn_menu_profiles() {
  local dir=""
  local -a profiles=()
  local candidate profile_name

  zmodload -F zsh/stat b:zstat 2>/dev/null || return 1
  if (( ${+functions[_vpn_config_dir_resolve]} )); then
    dir=$(_vpn_config_dir_resolve 2>/dev/null) || dir=""
  else
    local REPLY=""
    _vpn_menu_cold_profile_dir && dir="$REPLY"
    while [[ "$dir" != "/" && "$dir" == */ ]]; do
      dir="${dir%/}"
    done
    if [[ "$dir" == /* && "${dir:a}" != "${dir:A}" ]]; then
      local prefix="" component=""
      local -A link_state=() parent_state=()
      for component in "${(@s:/:)dir}"; do
        [[ -n "$component" ]] || continue
        prefix+="/$component"
        [[ -L "$prefix" ]] || continue
        link_state=()
        parent_state=()
        if ! zstat -LH link_state -- "$prefix" 2>/dev/null \
          || ! zstat -H parent_state -- "${prefix:h}" 2>/dev/null \
          || (( link_state[uid] != 0 || parent_state[uid] != 0 \
            || (parent_state[mode] & 8#22) != 0 )); then
          dir=""
          break
        fi
      done
      [[ -n "$dir" ]] && dir="${dir:A}"
    fi
  fi

  if [[ "$dir" == /* && "${dir:a}" == "${dir:A}" \
    && -d "$dir" && ! -L "$dir" && -r "$dir" && -x "$dir" ]]; then
    local -A metadata=()
    zstat -H metadata -- "$dir" 2>/dev/null || return 0
    (( (metadata[uid] == 0 || metadata[uid] == EUID) \
      && (metadata[mode] & 8#22) == 0 )) || return 0
    for candidate in "$dir"/*.conf(N.); do
      profile_name="${${candidate:t}%.conf}"
      (( ${#profile_name} <= 64 )) || continue
      [[ "$profile_name" =~ '^[A-Za-z0-9][A-Za-z0-9._-]*$' ]] || continue
      metadata=()
      zstat -H metadata -- "$candidate" 2>/dev/null || continue
      (( metadata[nlink] == 1 \
        && (metadata[uid] == 0 || metadata[uid] == EUID) \
        && (metadata[mode] & 8#77) == 0 \
        && metadata[size] <= 1048576 )) || continue
      profiles+=("$profile_name")
      (( ${#profiles[@]} < 256 )) || break
    done
  fi

  (( ${#profiles[@]} > 0 )) && _describe -t profiles 'profile' profiles
}

# `vpn-menu <command>` completes the command token first; a direct command
# such as `vpn-on` is already the first word.
local subcommand=""
if [[ "${words[1]:-}" == "vpn-menu" ]]; then
  _arguments -C \
    '(- *)'{-h,--help}'[Show usage]' \
    '1:subcommand:->subcommands' \
    '*::arguments:->arguments'

  case "$state" in
    subcommands)
      _describe -t subcmds 'subcommand' subcmds
      return
      ;;
    arguments)
      subcommand="${words[1]:-}"
      ;;
    *)
      return
      ;;
  esac
else
  subcommand="${words[1]:-}"
fi

case "$subcommand" in
  vpn-on|vpn-off|vpn-default-set)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '1:profile:_vpn_menu_profiles'
    ;;
  vpn-off-all)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --dry-run)--dry-run[Show the disconnect plan and stop]' \
      '(-h --help -y --yes)'{-y,--yes}'[Skip the confirmation prompt]'
    ;;
  vpn-profile-create)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '1:new profile name:'
    ;;
  vpn-profile-import)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '1:configuration file:_files -g "*.conf"'
    ;;
  vpn-profile-rename)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --dry-run)--dry-run[Show the rename plan and stop]' \
      '(-h --help -y --yes)'{-y,--yes}'[Skip the confirmation prompts]' \
      '1:current profile:_vpn_menu_profiles' \
      '2:new profile name:'
    ;;
  vpn-config-edit)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '1:profile:_vpn_menu_profiles'
    ;;
  vpn-config-restore)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --dry-run)--dry-run[Show the restore plan and stop]' \
      '(-h --help -y --yes)'{-y,--yes}'[Skip the confirmation prompt]' \
      '1:profile:_vpn_menu_profiles'
    ;;
  vpn-profile-remove)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --dry-run)--dry-run[Show the removal plan and stop]' \
      '(-h --help --with-backup)--with-backup[Also remove matching backup and pre-restore copies]' \
      '(-h --help -y --yes)'{-y,--yes}'[Skip the confirmation prompts]' \
      '1:profile:_vpn_menu_profiles'
    ;;
  vpn-default-clear)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help -y --yes)'{-y,--yes}'[Skip the confirmation prompt]'
    ;;
  vpn-mtu-probe)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --target)--target[Probe this IPv4 address or host name]:host:_hosts' \
      '(-h --help --profile)--profile[Name this WireGuard profile in the advice]:profile:_vpn_menu_profiles' \
      '(-h --help --json)--json[Print one JSON object on stdout]'
    ;;
  *)
    _arguments '(- *)'{-h,--help}'[Show command usage]'
    ;;
esac
