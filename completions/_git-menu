  git-switch)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --carry)--stash[Stash tracked changes before switching]' \
      '(-h --help --stash)--carry[Keep tracked changes in the working tree]' \
      '(-h --help -y --yes)--dry-run[Display the switch plan without changing anything]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the switch plan]' \
      '(-h --help)1::branch:_git_menu_complete_switch_branches'
    ;;
  git-recover)
