_git_menu_complete_stashes() {
  local stash_output=""
  local -aU stash_targets=()

  stash_output=$(command git stash list --max-count=500 \
    --format='%gd%x09%H' 2>/dev/null) || stash_output=""
  local stash_record stash_selector stash_oid
  for stash_record in "${(@f)stash_output}"; do
    [[ "$stash_record" == *$'\t'* ]] || continue
    stash_selector="${stash_record%%$'\t'*}"
    stash_oid="${stash_record#*$'\t'}"
    [[ "$stash_selector" == stash@\{<->\} ]] \
      && stash_targets+=("$stash_selector")
    [[ "$stash_oid" =~ '^[0-9A-Fa-f]{40,64}$' ]] \
      && stash_targets+=("$stash_oid")
  done

  if (( ${#stash_targets[@]} )); then
    _describe -t git-stashes 'current Git stash selector or OID' stash_targets
  else
    _message 'current Git stash selector or OID'
  fi
}

_git_menu_complete_remotes() {
  local remote_output=""
  local -aU remote_names=()

  remote_output=$(command git remote 2>/dev/null) || remote_output=""
  [[ -n "$remote_output" ]] && remote_names=("${(@f)remote_output}")
  (( ${#remote_names[@]} > 500 )) \
    && remote_names=("${remote_names[1,500]}")
  if (( ${#remote_names[@]} )); then
    _describe -t git-remotes 'configured Git remote' remote_names
  else
    _message 'configured Git remote'
  fi
}

_git_menu_complete_pr_number() {
  local pr_output=""
  local -aU pr_numbers=()
  local -i completion_rc=1

  pr_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/pull 2>/dev/null) || pr_output=""
  local pr_ref pr_number
  for pr_ref in "${(@f)pr_output}"; do
    [[ "$pr_ref" == refs/pull/<->/* ]] || continue
    pr_number="${${pr_ref#refs/pull/}%%/*}"
    [[ "$pr_number" == <-> && 10#$pr_number -ge 1 ]] || continue
    pr_numbers+=("$pr_number")
  done

  if (( ${#pr_numbers[@]} )); then
    _describe -t git-cached-prs \
      'locally cached pull request number' pr_numbers \
      && completion_rc=0
  fi
  _guard '[1-9][0-9]#' 'positive pull request number' \
    && completion_rc=0
  return $completion_rc
}

local -a subcmds
subcmds=(
  'clean-branches:Preview and remove selected local branches'
  'clean-remote-merged:Preview and remove merged remote branches'
  'git-amend:Change the last commit message, content, or author'
  'git-auth:Show repository identity and authentication state'
  'git-discard:Preview and discard file changes or all changes'
  'git-identity-check:Compare the repository identity with its workspace profile'
  'git-identity-switcher:Inspect or apply a configured Git identity'
  'git-pr-checkout:Check out a pull request branch'
  'git-pr-create:Create a GitHub pull request'
  'git-pull:Pull or fetch remote changes'
  'git-push:Push branches to a remote'
  'git-recover:Restore an unreachable commit as a new branch'
  'git-stash:Save, apply, pop, inspect, or drop stashes'
  'git-status:Show repository status'
  'git-switch:Switch to a local or remote branch'
  'git-tag-create:Create a tag'
  'git-tag-delete:Preview and delete tags'
  'git-tag-push:Push tags to a remote'
  'git-tag-verify:Verify a tag signature'
  'git-undo-commit:Preview and undo the latest commit'
  'git-unstage:Remove files from the next commit'
)

if (( ${words[(I)-h]} || ${words[(I)--help]} )); then
  _message 'no additional arguments'
  return
fi

local subcommand=""
if [[ "${words[1]:-}" == "git-menu" ]]; then
  _arguments -C \
    '(- *)'{-h,--help}'[Show usage]' \
    '(-h --help)1:subcommand:->subcommands' \
    '(-h --help)*::argument:->arguments'

  case "$state" in
    subcommands)
      _describe -t git-subcommands 'Git command' subcmds
      return
      ;;
    arguments)
      subcommand="${words[1]:-}"
      ;;
    *)
      return
      ;;
  esac
else
  subcommand="${words[1]:-}"
fi

case "$subcommand" in
  clean-branches)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help -y --yes)--dry-run[Display the frozen deletion plan without changing refs]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the frozen deletion plan]' \
      '(-h --help)*:local branch:_git_menu_complete_local_branches'
    ;;
  clean-remote-merged)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --remote)--remote[Select a configured remote]:remote:_git_menu_complete_remotes' \
      '(-h --help -y --yes)--dry-run[Display the frozen deletion plan without changing refs]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the frozen deletion plan]' \
      '(-h --help)*:remote branch:_git_menu_complete_remote_branches'
    ;;
  git-identity-switcher)
    if (( ${words[(I)--status]} )); then
      _message 'no additional arguments'
    elif (( ${words[(I)--switch]} )); then
      _arguments \
        '(- *)'{-h,--help}'[Show command usage]' \
        '(--status --switch)--switch[Apply a configured identity]:profile:_git_menu_complete_identity_profile' \
        '1:scope:(local global)'
    else
      _arguments \
        '(- *)'{-h,--help}'[Show command usage]' \
        '(-h --help --switch)--status[Show active local and global identity]' \
        '(-h --help --status)--switch[Apply a configured identity]:profile:_git_menu_complete_identity_profile'
    fi
    ;;
  git-discard)
    if (( ${words[(I)--all]} )); then
      _arguments \
        '(- *)'{-h,--help}'[Show command usage]' \
        '(-h --help)--all[Reset every staged and unstaged tracked change to HEAD]' \
        '(-h --help)--include-untracked[Also delete untracked files; ignored files stay]' \
        '(-h --help -y --yes)--dry-run[Display the exact discard plan without changing files]' \
        '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the discard plan]'
    else
      _arguments \
        '(- *)'{-h,--help}'[Show command usage]' \
        '(-h --help)--all[Reset every staged and unstaged tracked change to HEAD]' \
        '(-h --help -y --yes)--dry-run[Display the exact discard plan without changing files]' \
        '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the discard plan]'
    fi
    ;;
  git-unstage)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help)--all[Unstage every staged file]' \
      '(-h --help -y --yes)--dry-run[Display the unstage plan without changing the index]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm losing staged versions missing from the working tree]'
    ;;
  git-amend)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help -m --message)'{-m,--message}'[Replace the subject line and keep the body]:subject line:' \
      '(-h --help)--staged[Add the staged changes to the last commit]' \
      '(-h --help)--reset-author[Set the author to the current Git identity]' \
      '(-h --help -y --yes)--dry-run[Display the amend plan without rewriting the commit]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the amend plan]'
    ;;
  git-stash)
    local stash_action=""
    local stash_word
    for stash_word in "${words[@]}"; do
      [[ "$stash_word" == (save|create|apply|pop|drop|branch) ]] || continue
      stash_action="$stash_word"
      break
    done
    case "$stash_action" in
      save|create)
        _arguments \
          '(- *)'{-h,--help}'[Show command usage]' \
          '(-h --help -u --include-untracked --keep-index)'{-u,--include-untracked}'[Also save untracked non-ignored files]' \
          '(-h --help -u --include-untracked)--keep-index[Keep staged changes in the working tree]' \
          '(-h --help -m --message)'{-m,--message}'[Record a stash message]:message:' \
          '(-h --help -y --yes)--dry-run[Display the exact save plan without changing state]' \
          '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the save plan]' \
          '1:action:('"$stash_action"')'
        ;;
      apply|pop)
        _arguments \
          '(- *)'{-h,--help}'[Show command usage]' \
          '(-h --help -y --yes)--dry-run[Display the exact stash plan without changing state]' \
          '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the stash plan]' \
          '1:action:('"$stash_action"')' \
          '2::stash target:_git_menu_complete_stashes'
        ;;
      drop)
        _arguments \
          '(- *)'{-h,--help}'[Show command usage]' \
          '(-h --help -y --yes)--dry-run[Display the exact drop plan without changing state]' \
          '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm stash deletion]' \
          '1:action:(drop)' \
          '*:stash target:_git_menu_complete_stashes'
        ;;
      branch)
        _arguments \
          '(- *)'{-h,--help}'[Show command usage]' \
          '(-h --help -y --yes)--dry-run[Display the exact branch plan without changing state]' \
          '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm branch creation]' \
          '1:action:(branch)' \
          '2:stash target:_git_menu_complete_stashes' \
          '3:new branch name:'
        ;;
      *)
        _arguments \
          '(- *)'{-h,--help}'[Show command usage]' \
          '(-h --help -y --yes)--dry-run[Display stash plans without changing state]' \
          '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm stash plans]' \
          '1:action:(save apply pop drop branch)'
        ;;
    esac
    ;;
  git-undo-commit)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --mixed --hard)--soft[Keep index and worktree changes]' \
      '(-h --help --soft --hard)--mixed[Reset the index and keep worktree changes]' \
      '(-h --help --soft --mixed)--hard[Discard index and worktree changes]' \
      '(-h --help --yes)--dry-run[Display target OIDs and affected paths without resetting]' \
      '(-h --help --dry-run)--yes[Confirm the reset plan]'
    ;;
  git-pr-create)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help)--base[Select the pull request base branch]:base branch:_git_menu_complete_switch_branches' \
      '(-h --help --fill)--title[Set the pull request title]:title:' \
      '(-h --help --fill)--body[Set the pull request body; requires --title]:body:' \
      '(-h --help --title --body)--fill[Derive title and body from commits]' \
      '(-h --help)--draft[Create a draft pull request]' \
      '(-h --help -y --yes)--dry-run[Display the pull request plan without publishing]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm branch publication and pull request creation]'
    ;;
  git-pr-checkout)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help)1:pull request number:_git_menu_complete_pr_number'
    ;;
  git-pull)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --remote)--remote[Select a configured remote]:remote:_git_menu_complete_remotes' \
      '(-h --help --ref --fetch-prune)--ref[Fetch a full refs/heads source ref]:full branch ref:_git_menu_complete_full_branch_refs' \
      '(-h --help --rebase --ff-only --fetch --fetch-prune)--merge[Merge the fetched object]' \
      '(-h --help --merge --ff-only --fetch --fetch-prune)--rebase[Rebase onto the fetched object]' \
      '(-h --help --merge --rebase --fetch --fetch-prune)--ff-only[Require a fast-forward merge]' \
      '(-h --help --merge --rebase --ff-only --fetch-prune)--fetch[Fetch without changing HEAD]' \
      '(-h --help --ref --merge --rebase --ff-only --fetch)--fetch-prune[Fetch all refs and prune stale tracking refs]' \
      '(-h --help -y --yes)--dry-run[Display the fetch plan without changing repository state]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the fetch and integration plan]'
    ;;
  git-push)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --remote)--remote[Select a configured remote]:remote:_git_menu_complete_remotes' \
      '(-h --help --ref --all)--ref[Select a full refs/heads destination]:full branch ref:_git_menu_complete_full_branch_refs' \
      '(-h --help --set-upstream --force-with-lease --all)--set-upstream[Record the destination as the branch upstream]' \
      '(-h --help --set-upstream --force-with-lease --all)--force-with-lease[Rewrite one branch with an exact OID lease]' \
      '(-h --help --ref --set-upstream --force-with-lease)--all[Push every local branch]' \
      '(-h --help -y --yes)--dry-run[Display the push plan without changing the remote]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the push plan]'
    ;;
  git-tag-create)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --name)--name[Set the new tag name]:new tag name:' \
      '(-h --help)--target[Select the commit to tag]:revision:_git_menu_complete_revisions' \
      '(-h --help --message --lightweight)--message[Set the annotation or signature message]:message:' \
      '(-h --help --annotated --signed --lightweight)--annotated[Create an annotated tag; requires --message]' \
      '(-h --help --annotated --signed --lightweight)--signed[Create a signed tag; requires --message]' \
      '(-h --help --message --annotated --signed --lightweight)--lightweight[Create a lightweight tag]' \
      '(-h --help)--push[Push the new tag after local creation]' \
      '(-h --help --remote)--remote[Select the remote used by --push]:remote:_git_menu_complete_remotes' \
      '(-h --help -y --yes)--dry-run[Display the tag creation plan without changing refs]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm tag creation]'
    ;;
  git-tag-verify)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help)1:tag:_git_menu_complete_tags'
    ;;
  git-tag-push)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --remote)--remote[Select a configured remote]:remote:_git_menu_complete_remotes' \
      '(-h --help -y --yes)--dry-run[Display the push plan without changing the remote]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the tag push plan]' \
