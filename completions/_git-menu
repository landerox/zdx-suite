_git_menu_complete_stashes() {
  local stash_output=""
  local -aU stash_targets=()

  stash_output=$(command git stash list --max-count=500 \
    --format='%gd%x09%H' 2>/dev/null) || stash_output=""
  local stash_record stash_selector stash_oid
  for stash_record in "${(@f)stash_output}"; do
    [[ "$stash_record" == *$'\t'* ]] || continue
    stash_selector="${stash_record%%$'\t'*}"
    stash_oid="${stash_record#*$'\t'}"
    [[ "$stash_selector" == stash@\{<->\} ]] \
      && stash_targets+=("$stash_selector")
    [[ "$stash_oid" =~ '^[0-9A-Fa-f]{40,64}$' ]] \
      && stash_targets+=("$stash_oid")
  done

  if (( ${#stash_targets[@]} )); then
    _describe -t git-stashes 'current Git stash selector or OID' stash_targets
  else
    _message 'current Git stash selector or OID'
  fi
}

_git_menu_complete_remotes() {
  local remote_output=""
  local -aU remote_names=()

  remote_output=$(command git remote 2>/dev/null) || remote_output=""
  [[ -n "$remote_output" ]] && remote_names=("${(@f)remote_output}")
  (( ${#remote_names[@]} > 500 )) \
    && remote_names=("${remote_names[1,500]}")
  if (( ${#remote_names[@]} )); then
    _describe -t git-remotes 'configured Git remote' remote_names
  else
    _message 'configured Git remote'
  fi
}

_git_menu_complete_pr_number() {
  local pr_output=""
  local -aU pr_numbers=()
  local -i completion_rc=1

  pr_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/pull 2>/dev/null) || pr_output=""
  local pr_ref pr_number
  for pr_ref in "${(@f)pr_output}"; do
    [[ "$pr_ref" == refs/pull/<->/* ]] || continue
    pr_number="${${pr_ref#refs/pull/}%%/*}"
    [[ "$pr_number" == <-> && 10#$pr_number -ge 1 ]] || continue
    pr_numbers+=("$pr_number")
  done

  if (( ${#pr_numbers[@]} )); then
    _describe -t git-cached-prs \
      'locally cached pull request number' pr_numbers \
      && completion_rc=0
  fi
  _guard '[1-9][0-9]#' 'positive pull request number' \
    && completion_rc=0
  return $completion_rc
}

