# Value discovery reads only local Git metadata and caps every candidate list.
_git_menu_complete_identity_profile() {
  local -a profile_names=()
  if [[ "${(t)ZDX_GIT_IDENTITIES}" == *association* ]]; then
    profile_names=("${(@ok)ZDX_GIT_IDENTITIES}")
    (( ${#profile_names[@]} > 500 )) \
      && profile_names=("${profile_names[1,500]}")
  fi
  if (( ${#profile_names[@]} )); then
    _describe -t git-identity-profiles 'Git identity profile' profile_names
  else
    _message 'configured Git identity profile'
  fi
}

_git_menu_complete_local_branches() {
  local branch_output=""
  local -aU branch_names=()

  branch_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/heads 2>/dev/null) || branch_output=""
  local branch_ref
  for branch_ref in "${(@f)branch_output}"; do
    [[ "$branch_ref" == refs/heads/* ]] || continue
    branch_names+=("${branch_ref#refs/heads/}")
  done

  if (( ${#branch_names[@]} )); then
    _describe -t git-local-branches 'local Git branch' branch_names
  else
    _message 'local Git branch'
  fi
}

_git_menu_complete_branches() {
  local branch_output=""
  local -aU branch_names=()

  branch_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/heads refs/remotes 2>/dev/null) \
    || branch_output=""
  local branch_ref
  for branch_ref in "${(@f)branch_output}"; do
    case "$branch_ref" in
      refs/heads/*)
        branch_names+=("${branch_ref#refs/heads/}")
        ;;
      refs/remotes/*)
        [[ "$branch_ref" == refs/remotes/*/HEAD ]] && continue
        branch_names+=("${branch_ref#refs/remotes/}")
        ;;
    esac
  done

  if (( ${#branch_names[@]} )); then
    _describe -t git-branches \
      'local or remote-tracking Git branch' branch_names
  else
    _message 'local or remote-tracking Git branch'
  fi
}

_git_menu_complete_switch_branches() {
  local branch_output=""
  local -aU branch_names=()

  branch_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/heads refs/remotes 2>/dev/null) \
    || branch_output=""
  local branch_ref remote_branch
  for branch_ref in "${(@f)branch_output}"; do
    case "$branch_ref" in
      refs/heads/*)
        branch_names+=("${branch_ref#refs/heads/}")
        ;;
      refs/remotes/*)
        [[ "$branch_ref" == refs/remotes/*/HEAD ]] && continue
        remote_branch="${branch_ref#refs/remotes/}"
        branch_names+=("${remote_branch#*/}")
        ;;
    esac
  done

  if (( ${#branch_names[@]} )); then
    _describe -t git-switch-branches \
      'local or uniquely cached remote Git branch' branch_names
  else
    _message 'local or uniquely cached remote Git branch'
  fi
}

_git_menu_complete_remote_branches() {
  local branch_output=""
  local -aU branch_names=()

  branch_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/remotes 2>/dev/null) || branch_output=""
  local branch_ref remote_branch
  for branch_ref in "${(@f)branch_output}"; do
    [[ "$branch_ref" == refs/remotes/* \
      && "$branch_ref" != refs/remotes/*/HEAD ]] || continue
    remote_branch="${branch_ref#refs/remotes/}"
    branch_names+=("${remote_branch#*/}")
  done

  if (( ${#branch_names[@]} )); then
    _describe -t git-remote-branches \
      'cached remote Git branch' branch_names
  else
    _message 'cached remote Git branch'
  fi
}

_git_menu_complete_revisions() {
  local ref_output=""
  local -aU revision_names=(HEAD)

  ref_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/heads refs/remotes refs/tags 2>/dev/null) \
    || ref_output=""
  local ref_name
  for ref_name in "${(@f)ref_output}"; do
    case "$ref_name" in
      refs/heads/*)
        revision_names+=("${ref_name#refs/heads/}")
        ;;
      refs/remotes/*)
        [[ "$ref_name" == refs/remotes/*/HEAD ]] && continue
        revision_names+=("${ref_name#refs/remotes/}")
        ;;
      refs/tags/*)
        revision_names+=("${ref_name#refs/tags/}")
        ;;
    esac
  done

  _describe -t git-revisions 'local Git revision' revision_names
}

_git_menu_complete_full_branch_refs() {
  local ref_output=""
  local -aU branch_refs=()

  ref_output=$(command git for-each-ref \
    --count=500 --sort=refname \
    --format='%(refname)' refs/heads refs/remotes 2>/dev/null) \
    || ref_output=""
  local ref_name remote_branch
  for ref_name in "${(@f)ref_output}"; do
    case "$ref_name" in
      refs/heads/*)
        branch_refs+=("$ref_name")
        ;;
      refs/remotes/*)
        [[ "$ref_name" == refs/remotes/*/HEAD ]] && continue
        remote_branch="${ref_name#refs/remotes/}"
        branch_refs+=("refs/heads/${remote_branch#*/}")
        ;;
    esac
  done

  if (( ${#branch_refs[@]} )); then
    _describe -t git-full-branch-refs \
      'full refs/heads Git reference' branch_refs
  else
    _message 'full refs/heads Git reference'
  fi
