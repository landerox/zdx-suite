if (( ${words[(I)-h]} || ${words[(I)--help]} )); then
  _message 'no additional arguments'
  return
fi

local subcommand=""
if [[ "${words[1]:-}" == "git-menu" ]]; then
  _arguments -C \
    '(- *)'{-h,--help}'[Show usage]' \
    '(-h --help)1:subcommand:->subcommands' \
    '(-h --help)*::argument:->arguments'

  case "$state" in
    subcommands)
      _describe -t git-subcommands 'Git command' subcmds
      return
      ;;
    arguments)
      subcommand="${words[1]:-}"
      ;;
    *)
      return
      ;;
  esac
else
  subcommand="${words[1]:-}"
fi

case "$subcommand" in
  clean-branches)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help -y --yes)--dry-run[Display the frozen deletion plan without changing refs]' \
      '(-h --help --dry-run -y --yes)'{-y,--yes}'[Confirm the frozen deletion plan]' \
      '(-h --help)*:local branch:_git_menu_complete_local_branches'
    ;;
  clean-remote-merged)
    _arguments \
      '(- *)'{-h,--help}'[Show command usage]' \
      '(-h --help --remote)--remote[Select a configured remote]:remote:_git_menu_complete_remotes' \
      '(-h --help -y --yes)--dry-run[Display the frozen deletion plan without changing refs]' \
