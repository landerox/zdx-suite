_dev_menu_profiles() {
  local profile_dir="${DEV_PROFILE_DIR-.dev-suite-profiles}"
  local -a profiles=()
  local candidate
  local -A metadata=()

  [[ -n "$profile_dir" \
    && -d "$profile_dir" \
    && ! -L "$profile_dir" \
    && "${profile_dir:a}" == "${profile_dir:A}" ]] || return 1
  zmodload zsh/stat 2>/dev/null || return 1
  zstat -H metadata -- "$profile_dir" 2>/dev/null || return 1
  (( metadata[uid] == EUID \
    && (metadata[mode] & 8#7777) == 8#700 )) || return 1

  for candidate in "$profile_dir"/*.profile(N.); do
    [[ ! -L "$candidate" ]] || continue
    local profile_name="${${candidate:t}%.profile}"
    [[ ${#profile_name} -le 64 \
      && "$profile_name" == [a-zA-Z0-9]* \
      && "$profile_name" != *[^a-zA-Z0-9_.-]* ]] || continue
    metadata=()
    zstat -H metadata -- "$candidate" 2>/dev/null || continue
    (( metadata[uid] == EUID \
      && metadata[nlink] == 1 \
      && (metadata[mode] & 8#77) == 0 \
      && metadata[size] <= 8192 )) || continue
    profiles+=("$profile_name")
    (( ${#profiles[@]} >= 100 )) && break
  done

  if (( ${#profiles[@]} > 0 )); then
    _describe -t dev-profiles 'saved task profile' profiles
  else
    _message 'saved task profile'
  fi
}

if (( ${words[(I)-h]} || ${words[(I)--help]} )); then
  _message 'no additional arguments'
  return
fi

local subcommand=""
if [[ "${words[1]:-}" == "dev-menu" ]]; then
  _arguments -C \
    '(- *)'{-h,--help}'[Show usage]' \
    '(-h --help -p --profile)'{-m,--multi}'[Select independent batch-eligible tasks]' \
    '(-h --help -m --multi)'{-p,--profile}'[Run a saved task profile]::profile:_dev_menu_profiles' \
    '(-h --help -m --multi -p --profile)1:subcommand:->subcommands' \
    '(-h --help -m --multi -p --profile)*::argument:->arguments'

  case "$state" in
    subcommands)
      _describe -t dev-subcommands 'Developer command' subcmds
      return
      ;;
    arguments)
      subcommand="${line[1]:-${words[2]:-}}"
      ;;
    *)
      return
      ;;
  esac
else
  subcommand="${words[1]:-}"
fi

